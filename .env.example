# Visual brand theme
NEXT_PUBLIC_SITE_THEME=easy-shoping

# Same-origin PHP mailer (production). Leave unset to use /api/submit.php
# NEXT_PUBLIC_SUBMIT_API_URL=https://easy-shoping.com/api/submit.php

# Optional SMTP. Leave SMTP_HOST empty to use cPanel PHP mail()
# (create mailbox info@easy-shoping.com in cPanel first).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@easy-shoping.com
MAIL_FROM_NAME=Easy Shoping
MAIL_TO=info@easy-shoping.com
MAIL_TO_NAME=Easy Shoping
